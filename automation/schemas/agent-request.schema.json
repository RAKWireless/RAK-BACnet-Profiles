{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "issue", "evidence", "execution"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 2 },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number", "url", "bodySha", "vendor", "model", "profileName",
        "lorawanClass", "lorawanVersion", "downlinkSupport",
        "downlinkEvidenceStatus", "downlinkEvidenceText", "downlinkExamples",
        "fPortStatus", "uplinkEvidenceText", "uplinkExamples", "bacnetMapping",
        "bacnetMappingStatus", "bacnetMappingReferences", "requestedMappings"
      ],
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "url": { "type": "string", "minLength": 1 },
        "bodySha": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "vendor": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "profileName": { "type": "string", "minLength": 1 },
        "lorawanClass": { "type": "string", "enum": ["Class A", "Class B", "Class C"] },
        "lorawanVersion": { "type": "string", "enum": ["LORAWAN_1_0_2", "LORAWAN_1_0_3", "LORAWAN_1_0_4"] },
        "downlinkSupport": { "type": "string", "minLength": 1 },
        "downlinkEvidenceStatus": { "type": "string", "enum": ["not-requested", "explicit", "deferred"] },
        "downlinkEvidenceText": { "type": "string" },
        "downlinkExamples": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["command", "bacnetObject", "fPort", "value", "hex", "allowedValues", "expectedResponse", "reference", "complete"],
            "properties": {
              "command": { "type": ["string", "null"] },
              "bacnetObject": { "type": ["string", "null"] },
              "fPort": { "type": ["integer", "null"], "minimum": 1, "maximum": 254 },
              "value": { "type": ["number", "null"] },
              "hex": { "type": ["string", "null"], "pattern": "^(?:[0-9A-F]{2})+$" },
              "allowedValues": { "type": ["string", "null"] },
              "expectedResponse": { "type": ["string", "null"] },
              "reference": { "type": ["string", "null"] },
              "complete": { "type": "boolean" }
            }
          }
        },
        "fPortStatus": { "type": "string", "enum": ["explicit", "deferred"] },
        "uplinkEvidenceText": { "type": "string" },
        "uplinkExamples": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fPort", "explicitFPort", "hex"],
            "properties": {
              "fPort": { "type": ["integer", "null"], "minimum": 1, "maximum": 254 },
              "explicitFPort": { "type": "boolean" },
              "hex": { "type": "string", "pattern": "^(?:[0-9A-F]{2})+$" }
            }
          }
        },
        "bacnetMapping": { "type": "string", "minLength": 1 },
        "bacnetMappingStatus": { "type": "string" },
        "bacnetMappingReferences": { "type": "array", "items": { "type": "object" } },
        "requestedMappings": { "type": "array", "items": { "type": "object" } }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["officialDocument", "officialDocumentAttempt", "decoder", "fallback", "issues", "policy"],
      "properties": {
        "officialDocument": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["preparedPath", "url", "type", "pages", "sha256"],
          "properties": {
            "preparedPath": { "type": "string", "const": ".profile-agent/input/official-document.txt" },
            "url": { "type": "string" },
            "type": { "type": "string", "enum": ["pdf", "html", "text"] },
            "pages": { "type": ["integer", "null"], "minimum": 1 },
            "sha256": { "type": ["string", "null"] }
          }
        },
        "officialDocumentAttempt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "status", "sourceError", "extraction"],
          "properties": {
            "url": { "type": ["string", "null"] },
            "status": { "type": "string", "enum": ["not-attempted", "succeeded", "failed"] },
            "sourceError": {
              "type": ["object", "null"],
              "additionalProperties": false,
              "required": ["code", "stage"],
              "properties": {
                "code": { "type": ["string", "null"] },
                "stage": { "type": ["string", "null"] }
              }
            },
            "extraction": {
              "type": ["object", "null"],
              "additionalProperties": false,
              "required": ["type", "pages", "sha256"],
              "properties": {
                "type": { "type": "string", "enum": ["pdf", "html", "text"] },
                "pages": { "type": ["integer", "null"], "minimum": 1 },
                "sha256": { "type": ["string", "null"] }
              }
            }
          }
        },
        "decoder": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["preparedPath", "url", "origin", "authority", "sha256"],
          "properties": {
            "preparedPath": { "type": "string", "const": ".profile-agent/input/decoder.txt" },
            "url": { "type": ["string", "null"] },
            "origin": { "type": ["string", "null"] },
            "authority": { "type": "string" },
            "sha256": { "type": ["string", "null"] }
          }
        },
        "fallback": {
          "type": "object",
          "additionalProperties": false,
          "required": ["used", "origin", "reasonCode"],
          "properties": {
            "used": { "type": "boolean" },
            "origin": { "type": ["string", "null"] },
            "reasonCode": { "type": ["string", "null"] }
          }
        },
        "issues": {
          "type": "array",
          "items": { "type": "object" }
        },
        "policy": { "type": "string", "minLength": 1 }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "attempt", "reviewCycle", "authorizedReviewerFeedback", "profilePath", "fixturePath", "validationCommand", "maxPayloadBytes"],
      "properties": {
        "mode": { "type": "string", "minLength": 1 },
        "attempt": { "type": "integer", "minimum": 1 },
        "reviewCycle": { "type": "integer", "minimum": 0 },
        "authorizedReviewerFeedback": { "type": "string" },
        "profilePath": { "type": "string", "minLength": 1 },
        "fixturePath": { "type": "string", "minLength": 1 },
        "validationCommand": { "type": "string", "minLength": 1 },
        "maxPayloadBytes": { "type": "integer", "const": 255 }
      }
    }
  }
}

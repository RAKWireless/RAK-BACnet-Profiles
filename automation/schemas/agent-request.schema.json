{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "issue", "evidence", "execution"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 2 },
    "issue": { "type": "object" },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["officialDocument", "officialDocumentAttempt", "decoder", "fallback", "issues", "policy"],
      "properties": {
        "officialDocument": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["preparedPath", "url", "type", "pages", "sha256"],
          "properties": {
            "preparedPath": { "type": "string", "const": ".profile-agent/input/official-document.txt" },
            "url": { "type": "string" },
            "type": { "type": "string", "enum": ["pdf", "html", "text"] },
            "pages": { "type": ["integer", "null"], "minimum": 1 },
            "sha256": { "type": ["string", "null"] }
          }
        },
        "officialDocumentAttempt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "status", "sourceError", "extraction"],
          "properties": {
            "url": { "type": ["string", "null"] },
            "status": { "type": "string", "enum": ["not-attempted", "succeeded", "failed"] },
            "sourceError": {
              "type": ["object", "null"],
              "additionalProperties": false,
              "required": ["code", "stage"],
              "properties": {
                "code": { "type": ["string", "null"] },
                "stage": { "type": ["string", "null"] }
              }
            },
            "extraction": {
              "type": ["object", "null"],
              "additionalProperties": false,
              "required": ["type", "pages", "sha256"],
              "properties": {
                "type": { "type": "string", "enum": ["pdf", "html", "text"] },
                "pages": { "type": ["integer", "null"], "minimum": 1 },
                "sha256": { "type": ["string", "null"] }
              }
            }
          }
        },
        "decoder": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["preparedPath", "url", "origin", "authority", "sha256"],
          "properties": {
            "preparedPath": { "type": "string", "const": ".profile-agent/input/decoder.txt" },
            "url": { "type": ["string", "null"] },
            "origin": { "type": ["string", "null"] },
            "authority": { "type": "string" },
            "sha256": { "type": ["string", "null"] }
          }
        },
        "fallback": {
          "type": "object",
          "additionalProperties": false,
          "required": ["used", "origin", "reasonCode"],
          "properties": {
            "used": { "type": "boolean" },
            "origin": { "type": ["string", "null"] },
            "reasonCode": { "type": ["string", "null"] }
          }
        },
        "issues": {
          "type": "array",
          "items": { "type": "object" }
        },
        "policy": { "type": "string", "minLength": 1 }
      }
    },
    "execution": { "type": "object" }
  }
}

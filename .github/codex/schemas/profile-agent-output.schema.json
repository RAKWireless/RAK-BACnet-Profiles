{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "issueNumber", "issueBodySha", "summary", "profilePath", "fixturePath", "evidenceLevel", "resolvedMappings", "fPortPolicy", "warnings", "evidenceMatrix", "blocker"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "status": { "type": "string", "enum": ["generated", "blocked"] },
    "issueNumber": { "type": "integer", "minimum": 1 },
    "issueBodySha": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "profilePath": { "type": ["string", "null"], "pattern": "^profiles/[A-Za-z0-9-]+/[A-Za-z0-9-]+\\.yaml$" },
    "fixturePath": { "type": ["string", "null"], "pattern": "^profiles/[A-Za-z0-9-]+/tests/[A-Za-z0-9-]+\\.test\\.json$" },
    "evidenceLevel": { "type": ["string", "null"], "enum": ["known-answer", "documentation-only", "decoder-derived", null] },
    "resolvedMappings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type", "units"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "enum": ["AnalogInputObject", "AnalogValueObject", "BinaryInputObject", "BinaryValueObject", "OctetStringValueObject"] },
          "units": { "type": ["string", "null"] }
        }
      }
    },
    "fPortPolicy": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "ports", "citation"],
          "properties": {
            "mode": { "type": "string", "const": "fixed" },
            "ports": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1, "maximum": 223 } },
            "citation": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "representativeFPort", "citation"],
          "properties": {
            "mode": { "type": "string", "const": "agnostic" },
            "representativeFPort": { "type": "integer", "minimum": 1, "maximum": 223 },
            "citation": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "representativeFPort", "reason"],
          "properties": {
            "mode": { "type": "string", "const": "ignored" },
            "representativeFPort": { "type": "integer", "minimum": 1, "maximum": 223 },
            "reason": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "warnings": { "type": "array", "items": { "type": "string", "maxLength": 1000 } },
    "evidenceMatrix": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "officialDocument", "decoder", "knownPayload", "resolution", "resolvedValue", "rationale"],
        "properties": {
          "field": { "type": "string", "minLength": 1 },
          "officialDocument": { "type": ["string", "null"], "maxLength": 1000 },
          "decoder": { "type": ["string", "null"], "maxLength": 1000 },
          "knownPayload": { "type": ["string", "null"], "maxLength": 1000 },
          "resolution": { "type": "string", "enum": ["agreed", "payload-verified", "documentation-only", "decoder-verified", "conflict"] },
          "resolvedValue": { "type": ["string", "number", "boolean", "null"] },
          "rationale": { "type": "string", "minLength": 1, "maxLength": 2000 }
        }
      }
    },
    "blocker": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "retryable"],
          "properties": {
            "code": { "type": "string", "enum": ["evidence-conflict", "insufficient-evidence", "unsupported-scope"] },
            "message": { "type": "string", "minLength": 1, "maxLength": 2000 },
            "retryable": { "type": "boolean", "const": false }
          }
        }
      ]
    }
  }
}

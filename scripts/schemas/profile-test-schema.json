{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profile", "evidenceLevel", "sources", "testCases"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "profile": { "type": "string", "pattern": "^[A-Za-z0-9]+-[A-Za-z0-9-]+$" },
    "evidenceLevel": { "enum": ["known-answer", "documentation-only"] },
    "reviewMode": { "enum": ["single-model", "multi-model"] },
    "fPortPolicy": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "ports", "citation"],
          "properties": {
            "mode": { "const": "fixed" },
            "ports": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "integer", "minimum": 0, "maximum": 255 }
            },
            "citation": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "representativeFPort", "citation"],
          "properties": {
            "mode": { "const": "agnostic" },
            "representativeFPort": { "type": "integer", "minimum": 1, "maximum": 223 },
            "citation": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "reference"],
        "properties": {
          "type": { "enum": ["issue", "official-document", "vendor-decoder", "customer-data"] },
          "reference": { "type": "string", "minLength": 1 },
          "citation": { "type": "string" }
        }
      }
    },
    "robustness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "checkTruncation": { "type": "boolean" },
        "checkUnknownFPort": { "type": "boolean" }
      }
    },
    "testCases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "fPort", "input"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "messageType": { "type": "string" },
          "fPort": { "type": "integer", "minimum": 0, "maximum": 255 },
          "input": { "type": "string", "pattern": "^(?:[0-9A-Fa-f]{2}[\\s-]*)+$" },
          "description": { "type": "string" },
          "expectedOutput": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "channel", "value", "unit"],
              "properties": {
                "name": { "type": "string" },
                "channel": { "type": "integer", "minimum": 1 },
                "value": {},
                "unit": { "type": ["string", "null"] }
              }
            }
          }
        }
      }
    }
  }
}
